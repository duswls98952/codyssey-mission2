{
  "output_language": "ko",
  "wiki": {
    "enabled": false,
    "project_id": "",
    "team_id": "",
    "repo_id": "",
    "root": "",
    "path_template": "projects/{project_id}/{type}/{slug}.md",
    "default_scope": "project",
    "prompt_capture_mode": "metadata",
    "allow_full_prompt_export": false
  },
  "policy": {
    "agent": {
      "provider": "claude",
      "model": "",
      "reasoning_effort": "high"
    },
    "git": {
      "required_branch": "develop",
      "block_dirty_branch_switch": true,
      "commit_policy": "manual",
      "include_loom_metadata": true
    },
    "execution": {
      "allow_read_only_parallel": true
    },
    "validation": {
      "environment": "auto"
    },
    "context": {
      "previous_task_results_limit": 2,
      "required_doc_paths": []
    }
  }
}
